# Required
APP_PASSWORD=choose-a-long-password        # dashboard login (first sign-in creates the admin)
CRUSTDATA_API_KEY=                         # app.crustdata.com: the ONLY data key. No AI / LLM key is needed.
DATABASE_URL=                              # added automatically by the Vercel Neon integration
# Recommended
CRON_SECRET=                               # any random string; Vercel cron sends it as a Bearer token
TOKEN_KEY=                                 # optional: encrypts the Google refresh token (defaults to APP_PASSWORD)
# Optional
SD_COUNTRY=IND                             # where to discover sponsors (Crustdata country code, e.g. IND, USA, GBR)
SARVAM_API_KEY=                            # dashboard.sarvam.ai: voice and Indian languages in the assistant, replies and meeting notes
# Gmail sending (Google Cloud OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register in Google Cloud: https://<your-app>.vercel.app/api/google/callback
